# DevPilot AI Backend Environment Configuration

# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite by default, can configure to postgres (e.g. postgresql://user:password@localhost:5432/dbname)
DATABASE_URL=sqlite:///./devpilot.db

# Secret key for JWT signing. Replace with a secure random key in production
SECRET_KEY=devpilot_super_secret_key_change_me_in_production_12345
